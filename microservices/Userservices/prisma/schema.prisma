generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  name           String
  email          String           @unique
  password       String?
  role           Role             @default(STUDENT)
  isVerified     Boolean          @default(false)
  otp            String?
  otpExpiresAt   DateTime?
  provider       String?
  oauthId        String?
  profileImage   String?
  phoneNumber    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
}

enum Role {
  STUDENT
  TEACHER
}

model StudentProfile {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int      @unique
  educationLevel  String
  institution     String
  guardianName    String
  guardianPhone   String
  guardianEmail   String?
  dateOfBirth     DateTime?
  address         String?
  coverPhoto      String?
  profilePhoto    String?
  bio             String?  @db.Text
  quizResults     Quizresults[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TeacherProfile {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int      @unique
  education       String
  specialization  String
  experience      Int
  institution     String?
  certifications  String?
  rating          Float?
  coverPhoto      String?
  profilePhoto    String?
  bio             String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  quizzes         Quiz[]
  assignments     Assignment[]
  studyNotes      Studynote[]
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  duration    Int
  teacherId   Int
  teacher     TeacherProfile @relation(fields: [teacherId], references: [userId])
  questions   Question[]      
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id            String   @id @default(cuid())
  question      String   @db.Text
  correctAnswer String?  @db.Text
  options       Json?
  explanation   String?  @db.Text
  difficulty    String   
  type          String
  quizId        String?
  quiz          Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade) 
}


model Assignment {
  id          Int             @id @default(autoincrement())
  title       String
  description String          @db.Text
  teacher     TeacherProfile  @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  teacherId   Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Studynote {
  id          Int             @id @default(autoincrement())
  title       String
  description String          @db.Text
  teacher     TeacherProfile  @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  teacherId   Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model Quizresults{
  id          String     @id @default(cuid())
  title       String
  marks       Int 
  fullmark    Int      
  studentId   Int
  student     StudentProfile @relation(fields: [studentId], references: [userId])
  answeredquestions   AnsweredQuestion[]
  lessonId    Int
  courseId    Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AnsweredQuestion{
  id            String   @id @default(cuid())
  question      String   @db.Text
  correctAnswer String?  @db.Text
  useranswer    String?  @db.Text
  options       Json?    
  explanation   String?  @db.Text
  difficulty    String   
  type          String
  quizId        String?
  quizResultId String
  quiz          Quizresults?    @relation(fields: [quizResultId], references: [id], onDelete: Cascade) 
}
